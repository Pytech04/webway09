# Copy to .env and adjust for your environment.
# Never commit a real token.

# Required for remote/public deployments. Local loopback use can leave it empty.
WEBWAY_API_TOKEN=

# Explicit opt-out for public unauthenticated access. Do not use in production.
WEBWAY_ALLOW_UNAUTHENTICATED=0

# Comma-separated browser origins allowed to call the API. Empty means same-origin only.
WEBWAY_ALLOWED_ORIGINS=

# Outbound destination policy.
WEBWAY_ALLOWED_PORTS=80,443
WEBWAY_ALLOW_PRIVATE_HOSTS=0

# Response and scan limits.
WEBWAY_MAX_RESPONSE_BYTES=2097152
WEBWAY_MAX_CDX_BYTES=5242880
WEBWAY_MAX_ROBOTS_BYTES=131072
WEBWAY_MAX_ASSET_BYTES=1048576
WEBWAY_MAX_REQUEST_BYTES=65536
WEBWAY_MAX_URL_LENGTH=2048
WEBWAY_MAX_COOKIE_LENGTH=4096
WEBWAY_MAX_REGEX_LENGTH=200
WEBWAY_MAX_MATCHES=200
WEBWAY_MAX_TOTAL_MATCHES=1000
WEBWAY_MAX_SNAPSHOTS=200
WEBWAY_MAX_ASSETS=20
WEBWAY_REGEX_TIMEOUT=2.0

# Rate limiting (per process, in memory).
WEBWAY_RATE_LIMIT_MAX=30
WEBWAY_RATE_LIMIT_WINDOW=60

# Secret handling. Keep 0 for redacted output.
WEBWAY_REVEAL_SECRETS=0

# Flask. Keep debug off in deployments.
FLASK_DEBUG=0
WEBWAY_HOST=127.0.0.1
